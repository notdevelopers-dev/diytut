POSTGRES_DB=diytut
POSTGRES_USER=diytut
# Example: openssl rand -hex 32
POSTGRES_PASSWORD=
TUNNEL_TOKEN=

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Please contact the backend developer for this information.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be listed in the OAuth client's authorized redirect URIs.
# Development: http://localhost:5173(or 8080)/api/auth/google/callback
GOOGLE_REDIRECT_URI=https://<domain>/api/auth/google/callback
# Signs session JWTs. Example: openssl rand -hex 32
SECRET_KEY=

# Please comment out or delete COMPOSE_FILE for development:
COMPOSE_FILE=compose.yml

# Only if your `id -u` / `id -g` is not 1000:
# UID=1000
# GID=1000